# SmarterMail Configuration
# Public app origin; set your HTTPS domain before building for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SMARTERMAIL_URL=https://us1.workspace.org
SMARTERMAIL_CLIENT_ID=cranemail-files-app
PUBLIC_FOLDER=/public
TIMEZONE=Asia/Shanghai

# Better Auth uses NEXT_PUBLIC_SITE_URL as its origin unless BETTER_AUTH_URL is set.
# Generate a separate session secret with openssl rand -hex 32.
BETTER_AUTH_SECRET=

# Cryptographic Key for Password Encryption (AES-256-GCM)
# Recommend generating a secure random string (e.g., via `openssl rand -hex 32`)
ENCRYPTION_KEY=cranemail-files-app-default-development-encryption-key

# Turso Cloud Database Configuration
# Leave blank for local SQLite file database fallback (writes to local.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
